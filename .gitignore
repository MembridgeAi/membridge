*.log
# Test fixture homes. The MCP-registration checks need a home OUTSIDE the
# system temp dir (lib/mcp-register refuses to touch agent configs under it),
# so they mkdtemp here and clean up; this catches an interrupted run.
.mcp-wiring-*/
.DS_Store
dist/
app/lib/
app/bin/
app/vendor/

# internal business plan stays local
BUSINESS.md

# MemBridge's own output in its own repo: the daemon rewrites these while you
# use AI tools here. Per-machine derived data, not source — except team.json,
# the committed team link that makes every clone (any fork remote) resolve to
# the same shared project. See lib/teamsync.js linkProject.
**/.membridge/*
!**/.membridge/team.json
# stable MemBridge may also run in this checkout; keep its output out too
**/.membridge/*
!**/.membridge/team.json
# the beta edition may also run in this checkout; keep its output out too
**/.membridge-beta/*
!**/.membridge-beta/team.json
