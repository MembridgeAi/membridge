node_modules/
*.log
# Test fixture homes. The MCP-registration checks need a home OUTSIDE the
# system temp dir (lib/mcp-register refuses to touch agent configs under it),
# so they mkdtemp here and clean up; this catches an interrupted run.
.mcp-wiring-*/
.DS_Store
dist/
app/lib/
app/bin/
app/vendor/

# internal business plan stays local
BUSINESS.md

# MemBridge's own output in its own repo: the daemon rewrites these while you
# use AI tools here. Per-machine derived data, not source — except team.json,
# the committed team link that makes every clone (any fork remote) resolve to
# the same shared project. See lib/teamsync.js linkProject.
**/.membridge/*
!**/.membridge/team.json
# stable MemBridge may also run in this checkout; keep its output out too
**/.membridge/*
!**/.membridge/team.json
# the beta edition may also run in this checkout; keep its output out too
**/.membridge-beta/*
!**/.membridge-beta/team.json
CLAUDE.md
# ...but the agent-team kit's lead prompt is source, not MemBridge output. The
# bare pattern above matches at any depth and was silently swallowing it, which
# is why its roster drifted out of sync with the role files beside it.
!docs/agent-team/CLAUDE.md
AGENTS.md

.worktrees/
.claude/worktrees/
.superpowers/
.claude/settings.local.json
node_modules

# NOT ignored: docs/agent-team/ is project source.
#
# It was a personal scratch folder when this rule was written (an import folder
# shared between machines over Slack), and it stopped being one the moment the
# five-role kit was committed there. Leaving the rule in place left the directory
# ignored AND tracked at once, which has no upside: the seven existing files were
# already on master, so nothing was private, edits to them still committed -- but
# a NEW file, a sixth role, would never appear in `git diff`, would never be
# committed, and `git clean` would delete it without a word.
#
# It also has to stay tracked to work at all: the /team skill has every agent
# read docs/agent-team/agents/<role>.md by path, so untracked means the role
# files exist on one laptop only and a fresh clone or a new worktree has no team.
#
# The `!docs/agent-team/CLAUDE.md` negation further up is still required -- the
# bare `CLAUDE.md` pattern matches at any depth.
